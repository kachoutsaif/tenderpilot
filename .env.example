# Copiez ce fichier en .env puis remplissez votre clé. Ne commitez JAMAIS le fichier .env.

# Clé Groq gratuite : https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Base locale (docker compose up db)
DATABASE_URL=postgresql://tender:tender@localhost:5432/tenderpilot

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5
